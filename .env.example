# Atlas environment configuration (copy to .env and fill in values)

# Required — Groq API key from https://console.groq.com
GROQ_API_KEY=

# Optional — override default Groq models without changing code
# ATLAS_CHAT_MODEL sets the main chat model (default: openai/gpt-oss-120b)
ATLAS_CHAT_MODEL=
# ATLAS_VISION_MODEL sets screen vision / GUIDE / DO / TASK locate (default: qwen/qwen3.6-27b)
ATLAS_VISION_MODEL=
# ATLAS_WHISPER_MODEL sets Groq speech-to-text (default: whisper-large-v3-turbo)
ATLAS_WHISPER_MODEL=
# ATLAS_ENDPOINT_SILENCE_S — seconds of silence after you stop talking before Atlas
# transcribes and replies (default: 1.5, range 0.8–4.0)
# ATLAS_ENDPOINT_SILENCE_S=1.5
# ATLAS_FAST_MODEL sets memory fact extraction + persona drift (default: llama-3.1-8b-instant)
ATLAS_FAST_MODEL=
# ATLAS_WEBCAM_MODEL sets webcam frame analysis in the UI (default: meta-llama/llama-4-scout-17b-16e-instruct)
ATLAS_WEBCAM_MODEL=
# Optional — web search for [[RESEARCH:]] guided walkthrough grounding
# SEARCH_API_KEY=          # Brave (default), Bing, or SerpAPI depending on provider
# SEARCH_PROVIDER=brave    # brave | bing | serpapi (falls back to DuckDuckGo if unset)

# ATLAS_MAX_STEPS caps autonomous [[TASK:]] loop iterations (default: 40)
ATLAS_MAX_STEPS=
# ATLAS_STEP_TIMEOUT_S caps each UI animation/click step wait (default: 12)
# ATLAS_STEP_TIMEOUT_S=12
# ATLAS_REASONING_EFFORT for GPT-OSS models: low (default), medium, or high
ATLAS_REASONING_EFFORT=low
# ATLAS_SCREEN_PREFETCH=1 runs an extra vision call when you mention your screen (slower)
# ATLAS_SCREEN_PREFETCH=

# Optional — cloud sync (leave unset for local-only mode)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Optional — telemetry endpoints
# ATLAS_LICENSE_URL=
# ATLAS_FEEDBACK_URL=

# Optional — passive copilot / screen watcher
# ATLAS_SCREEN_POLL_INTERVAL=5
# ATLAS_VOICE_ALWAYS_ON=0
# ATLAS_CAPTURE_SYSTEM_AUDIO=0
